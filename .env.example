# Copy to .env (git-ignored) or set these in your environment before `flagpole serve`.
# Generate strong random values, e.g.:  python -c "import secrets; print(secrets.token_urlsafe(32))"

# Full access: create, change and delete flags, read the audit log.
FLAGPOLE_ADMIN_TOKEN=

# Read-only access for your apps: evaluate flags and download the flag snapshot.
FLAGPOLE_CLIENT_TOKEN=

# Optional: where the SQLite database lives (default: flagpole.db)
FLAGPOLE_DB=flagpole.db
